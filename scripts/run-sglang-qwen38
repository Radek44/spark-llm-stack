#!/usr/bin/env bash
set -euo pipefail

# Qwen3.8-27B NVFP4 + DSpark speculative decoding through SGLang.
#
# GB10 has native FP4 tensor cores, so the NVFP4 checkpoint plus the DSpark
# draft beats both llama.cpp+MTP (~27 tok/s) and vLLM+MTP (~24.5 tok/s) on this
# host. The generic SGLang cookbook selects the FP8 checkpoint and the fa3
# attention backend; both are Hopper-tuned and must not be copied here.

DGX_GPU_RUN="${DGX_GPU_RUN:-$HOME/ai-agent-os/bin/dgx-gpu-run}"
SGLANG_IMAGE="${SGLANG_IMAGE:-lmsysorg/sglang:v0.5.10.post1-cu130}"
CONTAINER_NAME="${CONTAINER_NAME:-qwen38-sglang}"

MODEL_ID="${MODEL_ID:-RadixArk/Qwen3.8-27B-NVFP4}"
MODEL_REVISION="${MODEL_REVISION:-52d1adc5f38aa5ebf099c29ed7025ba34cfbb854}"
DRAFT_MODEL_ID="${DRAFT_MODEL_ID:-RadixArk/Qwen3.8-27B-DSpark}"
DRAFT_MODEL_REVISION="${DRAFT_MODEL_REVISION:-923ed3a8572615643f0137e424e4ce4edd7f1cda}"

MODEL_PORT="${MODEL_PORT:-8171}"
SERVED_MODEL="${SERVED_MODEL:-qwen38}"
CONTEXT_LENGTH="${CONTEXT_LENGTH:-65536}"
CONTEXT_LENGTH_SAFE_MAX=65536
MEM_FRACTION_STATIC="${MEM_FRACTION_STATIC:-0.50}"
MEM_FRACTION_STATIC_SAFE_MAX=0.50
DSPARK_BLOCK_SIZE="${DSPARK_BLOCK_SIZE:-7}"
TORCH_COMPILE_MAX_BS="${TORCH_COMPILE_MAX_BS:-4}"
CONTINUOUS_DECODE_STEPS="${CONTINUOUS_DECODE_STEPS:-2}"
ATTENTION_BACKEND="${ATTENTION_BACKEND:-flashinfer}"
CONTAINER_MEMORY="${CONTAINER_MEMORY:-100g}"

HOST_HF_HOME="${HOST_HF_HOME:-$HOME/models/huggingface}"
CONTAINER_HF_HOME="${CONTAINER_HF_HOME:-/models/huggingface}"
SGLANG_ENTRY="${SGLANG_ENTRY:-python3 -m sglang.launch_server}"

[[ -x "$DGX_GPU_RUN" ]] || { echo "missing DGX GPU launcher: $DGX_GPU_RUN" >&2; exit 78; }
command -v docker >/dev/null 2>&1 || { echo "docker is required for the SGLang service" >&2; exit 78; }
[[ -d "$HOST_HF_HOME" ]] || { echo "missing Hugging Face home: $HOST_HF_HOME" >&2; exit 78; }

# The NVIDIA container runtime ships on this host but is not registered with
# Docker by default. Without it the container starts and then fails to see the
# GPU, which reads as a model bug rather than a host misconfiguration.
if ! docker info 2>/dev/null | grep -q 'nvidia'; then
  echo "docker has no nvidia runtime registered" >&2
  echo "run: sudo nvidia-ctk runtime configure --runtime=docker && sudo systemctl restart docker" >&2
  exit 78
fi

[[ "$CONTEXT_LENGTH" =~ ^[1-9][0-9]*$ ]] || {
  echo "CONTEXT_LENGTH must be a positive integer" >&2
  exit 78
}
if (( CONTEXT_LENGTH > CONTEXT_LENGTH_SAFE_MAX )) && \
   [[ "${QWEN38_ALLOW_LARGER_CONTEXT:-false}" != "true" ]]; then
  echo "CONTEXT_LENGTH exceeds the ${CONTEXT_LENGTH_SAFE_MAX}-token DGX Spark safety cap" >&2
  echo "set QWEN38_ALLOW_LARGER_CONTEXT=true only for a separately monitored promotion gate" >&2
  exit 78
fi

# mem-fraction-static above 0.50 either fails CUDA graph capture outright or
# silently falls back to eager mode, which costs roughly 25% throughput without
# reporting an error. Refuse it rather than ship a slow service that looks fine.
if awk -v v="$MEM_FRACTION_STATIC" -v m="$MEM_FRACTION_STATIC_SAFE_MAX" \
     'BEGIN { exit !(v > m) }' && \
   [[ "${QWEN38_ALLOW_LARGER_MEM_FRACTION:-false}" != "true" ]]; then
  echo "MEM_FRACTION_STATIC ${MEM_FRACTION_STATIC} exceeds the ${MEM_FRACTION_STATIC_SAFE_MAX} DGX Spark cap" >&2
  echo "0.95 causes CUDA graph failure or a silent eager fallback on this host" >&2
  echo "set QWEN38_ALLOW_LARGER_MEM_FRACTION=true only for a separately monitored promotion gate" >&2
  exit 78
fi

# SGLang probes a remote config on startup and hard-fails when the hub is
# unreachable, even with every weight already cached.
if [[ "${HF_HUB_OFFLINE:-0}" = "1" ]]; then
  echo "HF_HUB_OFFLINE=1 breaks SGLang startup even with a warm cache; unset it" >&2
  exit 78
fi

# A container outliving the lease holder would keep the GPU busy while the
# switcher believes the slot is free.
cleanup() { docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true; }
trap cleanup EXIT INT TERM
cleanup

docker_args=(
  run --rm --init
  --name "$CONTAINER_NAME"
  --gpus all
  --network host
  --ipc host
  --memory "$CONTAINER_MEMORY"
  -v "$HOST_HF_HOME:$CONTAINER_HF_HOME"
  -e "HF_HOME=$CONTAINER_HF_HOME"
  "$SGLANG_IMAGE"
)

server_args=(
  --model-path "$MODEL_ID"
  --revision "$MODEL_REVISION"
  --served-model-name "$SERVED_MODEL"
  --host 127.0.0.1
  --port "$MODEL_PORT"
  --tp-size 1
  --context-length "$CONTEXT_LENGTH"
  --mem-fraction-static "$MEM_FRACTION_STATIC"
  --attention-backend "$ATTENTION_BACKEND"
  --mamba-scheduler-strategy extra_buffer
  --num-continuous-decode-steps "$CONTINUOUS_DECODE_STEPS"
  --enable-torch-compile
  --torch-compile-max-bs "$TORCH_COMPILE_MAX_BS"
  --trust-remote-code
)

if [[ "${QWEN38_SPECULATIVE:-true}" = "true" ]]; then
  server_args+=(
    --speculative-algorithm DSPARK
    --speculative-draft-model-path "$DRAFT_MODEL_ID"
    --speculative-draft-model-revision "$DRAFT_MODEL_REVISION"
    --speculative-dspark-block-size "$DSPARK_BLOCK_SIZE"
    --speculative-draft-model-quantization unquant
  )
fi

exec "$DGX_GPU_RUN" --label qwen38-27b --profile llm \
  --timeout "${DGX_LOCK_TIMEOUT:-30}" -- \
  docker "${docker_args[@]}" $SGLANG_ENTRY "${server_args[@]}"
