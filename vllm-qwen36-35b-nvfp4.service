[Unit]
Description=vLLM Qwen3.6 35B A3B NVFP4 on 8170
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="HF_HOME=%h/.cache/huggingface"
Environment="VLLM_WORKER_MULTIPROC_METHOD=spawn"
Environment="MODEL_ID=nvidia/Qwen3.6-35B-A3B-NVFP4"
Environment="MODEL_PORT=8170"
Environment="SERVED_MODEL=fast_local"
Environment="MAX_MODEL_LEN=65536"
Environment="GPU_MEMORY_UTILIZATION=0.50"


# Install vLLM in %h/venvs/vllm-gb10 or override VLLM_PYTHON in a drop-in.
# Manual/on-demand only: do not enable this heavyweight service at boot.
# Raw systemctl starts are guarded too; use llm-switch for friendlier errors.
ExecCondition=/usr/bin/env bash %h/src/spark-llm-stack/scripts/check-memavailable-kib 90000000
ExecStart=/usr/bin/env bash -lc 'exec "${VLLM_PYTHON:-%h/venvs/vllm-gb10/bin/python}" -m vllm.entrypoints.openai.api_server --host 127.0.0.1 --port "${MODEL_PORT}" --model "${MODEL_ID}" --served-model-name "${SERVED_MODEL}" qwen3.6-35b-a3b-nvfp4 --trust-remote-code --max-model-len "${MAX_MODEL_LEN}" --gpu-memory-utilization "${GPU_MEMORY_UTILIZATION}" --enable-auto-tool-choice --tool-call-parser qwen3_xml'

Restart=on-failure
RestartSec=15
LimitNOFILE=1048576

[Install]
WantedBy=default.target
