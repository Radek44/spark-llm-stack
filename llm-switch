#!/usr/bin/env bash
# llm-switch v5 — lean DGX Spark AI service switcher
# Runtime:
#   llm-switch [fast_local|imagine|comfyui|litellm]
#   llm-switch off | all-off
#   llm-switch status
# Boot:
#   llm-switch boot-safe
#   llm-switch boot-router
#   llm-switch boot-default <slot> [--force-heavy]
#   llm-switch boot-status

set -euo pipefail

SLOTS=(fast_local imagine comfyui litellm)
MODEL_SLOTS=(fast_local imagine comfyui)

declare -A SVCS=(
  [fast_local]="vllm-laguna-s21-nvfp4.service"
  [imagine]="flux-klein.service"
  [comfyui]="comfyui.service"
  [litellm]="litellm.service"
)
declare -A PORTS=(
  [fast_local]=8170 [imagine]=8160 [comfyui]=8188 [litellm]=8180
)
declare -A ROLES=(
  [fast_local]="vLLM Laguna S 2.1 NVFP4 + DFlash local agent"
  [imagine]="FLUX.2-klein direct image generation"
  [comfyui]="ComfyUI diffusion workflows"
  [litellm]="LiteLLM local routing gateway"
)
declare -A MIN_MEM_KIB=(
  [fast_local]=115000000
  [imagine]=12000000
  [comfyui]=100000000
  [litellm]=2000000
)
WAIT_TIMEOUT_DEFAULT=300
WAIT_TIMEOUT_LAGUNA=1200

wait_ready() {
  local slot=$1 port=${PORTS[$1]} elapsed=0 timeout=$WAIT_TIMEOUT_DEFAULT
  [[ "$slot" = "fast_local" ]] && timeout=$WAIT_TIMEOUT_LAGUNA
  echo -n "  waiting for $slot on :$port"
  while ! curl -sf "http://127.0.0.1:$port/health" > /dev/null 2>&1 \
      && ! curl -sf "http://127.0.0.1:$port/v1/models" > /dev/null 2>&1 \
      && ! curl -sf "http://127.0.0.1:$port/sdcpp/v1/capabilities" > /dev/null 2>&1 \
      && ! curl -sf "http://127.0.0.1:$port/" > /dev/null 2>&1; do
    sleep 2; elapsed=$((elapsed+2)); echo -n "."
    if [ $elapsed -ge $timeout ]; then
      echo " TIMEOUT — stopping $slot"
      systemctl --user stop "${SVCS[$slot]}" 2>/dev/null || true
      systemctl --user reset-failed "${SVCS[$slot]}" 2>/dev/null || true
      exit 1
    fi
    if systemctl --user is-failed "${SVCS[$slot]}" >/dev/null 2>&1; then
      echo " FAILED"
      systemctl --user status "${SVCS[$slot]}" --no-pager --lines=20 >&2 || true
      exit 1
    fi
  done
  echo " ready (${elapsed}s)"
}

svc_running() { systemctl --user is-active "$1" > /dev/null 2>&1; }
svc_enabled() { systemctl --user is-enabled "$1" 2>/dev/null | grep -qx enabled; }

require_memory() {
  local slot="$1" min="${MIN_MEM_KIB[$slot]:-0}" avail
  avail=$(awk '/MemAvailable:/ {print $2}' /proc/meminfo)
  if (( avail < min )); then
    echo "  refusing to start $slot: MemAvailable ${avail} KiB < required ${min} KiB" >&2
    free -h
    echo "  stop other services first with: llm-switch off" >&2
    exit 1
  fi
}

stop_all_models_except() {
  local keep="$1"
  for slot in "${MODEL_SLOTS[@]}"; do
    local svc="${SVCS[$slot]}"
    if [ "$svc" != "$keep" ] && svc_running "$svc"; then
      echo "  stopping $slot..."
      systemctl --user stop "$svc"
    fi
  done
  sleep 3
}

show_status() {
  echo ""
  printf "  %-12s %-36s %-10s %-9s %s\n" "slot" "service" "state" "at-boot" "role"
  printf "  %-12s %-36s %-10s %-9s %s\n" "────────────" "────────────────────────────────────" "─────────" "─────────" "──────────────────────────────"
  for slot in "${SLOTS[@]}"; do
    local svc="${SVCS[$slot]}" port="${PORTS[$slot]}" state boot
    state=$(systemctl --user is-active "$svc" 2>/dev/null) || true
    boot=$(systemctl --user is-enabled "$svc" 2>/dev/null) || true
    [ -z "$state" ] && state="unknown"
    [ -z "$boot" ] && boot="missing"
    printf "  %-12s %-36s %-10s %-9s %s\n" "$slot" "$svc (:$port)" "$state" "$boot" "${ROLES[$slot]}"
  done
  echo ""
  free -h | awk '/Mem:/{printf "  memory: %s used / %s total / %s available\n", $3, $2, $7}'
  free -h | awk '/Swap:/{printf "  swap:   %s used / %s total / %s free\n", $3, $2, $4}'
  local lease="$HOME/.local/state/dgx-gpu/dgx-gpu-workload.lock"
  if [[ -r "$lease" ]] && command -v jq >/dev/null 2>&1; then
    local lease_state lease_label lease_profile
    lease_state=$(jq -r '.state // "unknown"' "$lease" 2>/dev/null || echo unknown)
    lease_label=$(jq -r '.label // "unknown"' "$lease" 2>/dev/null || echo unknown)
    lease_profile=$(jq -r '.profile // "unknown"' "$lease" 2>/dev/null || echo unknown)
    echo "  gpu lease: $lease_state ($lease_profile/$lease_label)"
  fi
  if command -v docker >/dev/null 2>&1; then
    local gpu_containers
    gpu_containers=$(for service in trellis-worker rig-worker rig-blender; do
      docker ps \
        --filter "label=com.docker.compose.project=spark-asset-forge-spark" \
        --filter "label=com.docker.compose.service=$service" \
        --format '{{.Names}}' 2>/dev/null
    done | sort -u)
    if [[ -n "$gpu_containers" ]]; then
      echo "  asset GPU containers: running"
      while IFS= read -r name; do echo "    $name"; done <<<"$gpu_containers"
    else
      echo "  asset GPU containers: off"
    fi
  fi
  if curl -fsS --max-time 5 http://127.0.0.1:8180/health/readiness >/dev/null 2>&1; then
    echo "  router: control plane ready"
    local deep healthy unhealthy
    deep=$(curl -fsS --max-time 10 http://127.0.0.1:8180/health 2>/dev/null) || deep=""
    if [[ -n "$deep" ]] && command -v jq >/dev/null 2>&1; then
      healthy=$(jq -r '(.healthy_endpoints // []) | length' <<<"$deep")
      unhealthy=$(jq -r '(.unhealthy_endpoints // []) | length' <<<"$deep")
      echo "  router: backends healthy=$healthy unhealthy=$unhealthy"
    fi
  else
    echo "  router: control plane unavailable"
  fi
  echo ""
}

stop_asset_gpu_containers() {
  command -v docker >/dev/null 2>&1 || return 0
  local ids=() service id
  for service in trellis-worker rig-worker rig-blender; do
    while IFS= read -r id; do
      [[ -n "$id" ]] && ids+=("$id")
    done < <(docker ps -q \
      --filter "label=com.docker.compose.project=spark-asset-forge-spark" \
      --filter "label=com.docker.compose.service=$service" 2>/dev/null)
  done
  if [[ ${#ids[@]} -gt 0 ]]; then
    echo "  stopping Asset Forge GPU containers..."
    docker stop "${ids[@]}" >/dev/null
  fi
}

boot_safe() {
  echo "→ disabling all managed services from auto-start at boot"
  for slot in "${SLOTS[@]}"; do
    local svc="${SVCS[$slot]}"
    if svc_enabled "$svc"; then
      echo "  disabling $slot ($svc)..."
      systemctl --user disable "$svc"
    fi
  done
  echo "  done. all managed services are manual-start only."
  boot_status
}

boot_router() {
  echo "→ safe boot mode: enable LiteLLM router only; keep heavyweight model/media services manual"
  for slot in "${SLOTS[@]}"; do
    local svc="${SVCS[$slot]}"
    if [ "$slot" = "litellm" ]; then
      svc_enabled "$svc" || systemctl --user enable "$svc"
    else
      svc_enabled "$svc" && systemctl --user disable "$svc"
    fi
  done
  boot_status
}

is_model_slot() {
  local needle="$1"
  for slot in "${MODEL_SLOTS[@]}"; do
    [ "$slot" = "$needle" ] && return 0
  done
  return 1
}

boot_default() {
  local slot="$1"
  if [ -z "${SVCS[$slot]:-}" ]; then
    echo "unknown slot: $slot" >&2
    echo "valid: ${SLOTS[*]}" >&2
    exit 1
  fi
  if is_model_slot "$slot" && [ "${2:-}" != "--force-heavy" ]; then
    echo "refusing to auto-start heavyweight slot '$slot' at boot without --force-heavy" >&2
    echo "safe default: llm-switch boot-router" >&2
    echo "explicit override: llm-switch boot-default $slot --force-heavy" >&2
    exit 1
  fi
  local keep="${SVCS[$slot]}"
  echo "→ setting $slot as boot default and disabling all others"
  for s in "${SLOTS[@]}"; do
    local svc="${SVCS[$s]}"
    if [ "$svc" = "$keep" ]; then
      svc_enabled "$svc" || systemctl --user enable "$svc"
    else
      svc_enabled "$svc" && systemctl --user disable "$svc"
    fi
  done
  boot_status
}

boot_status() {
  echo ""
  local any=0
  for slot in "${SLOTS[@]}"; do
    local svc="${SVCS[$slot]}"
    if svc_enabled "$svc"; then
      printf "  auto-start at boot: %s (%s)\n" "$slot" "$svc"
      any=1
    fi
  done
  if [ "$any" = "0" ]; then
    echo "  no managed service will auto-start at boot."
  fi
  echo ""
}

CMD="${1:-status}"

case "$CMD" in
  fast_local|imagine|comfyui|litellm)
    target_svc="${SVCS[$CMD]}"
    echo "→ $CMD mode (${ROLES[$CMD]})"
    if [ "$CMD" != "litellm" ]; then
      stop_all_models_except "$target_svc"
    fi
    if ! svc_running "$target_svc"; then
      require_memory "$CMD"
      systemctl --user start "$target_svc"
      wait_ready "$CMD"
    else
      echo "  already running"
    fi
    show_status
    ;;
  off)
    echo "→ stopping model/media services"
    for slot in "${MODEL_SLOTS[@]}"; do
      systemctl --user stop "${SVCS[$slot]}" 2>/dev/null || true
    done
    sleep 3; show_status
    ;;
  all-off)
    echo "→ stopping all model/media services and Asset Forge GPU workers"
    for slot in "${MODEL_SLOTS[@]}"; do
      systemctl --user stop "${SVCS[$slot]}" 2>/dev/null || true
    done
    stop_asset_gpu_containers
    sleep 3; show_status
    ;;
  status)
    show_status
    ;;
  boot-safe)
    boot_safe
    ;;
  boot-router)
    boot_router
    ;;
  boot-default)
    [ -n "${2:-}" ] || { echo "usage: llm-switch boot-default <slot> [--force-heavy]" >&2; echo "valid: ${SLOTS[*]}" >&2; exit 1; }
    boot_default "$2" "${3:-}"
    ;;
  boot-status)
    boot_status
    ;;
  -h|--help|help)
    cat <<EOF
llm-switch v5 — lean DGX Spark AI service switcher

Runtime:
  llm-switch fast_local    start Laguna S 2.1 through vLLM
  llm-switch litellm       start LiteLLM router without stopping models
  llm-switch imagine       start FLUX.2-klein direct image service
  llm-switch comfyui       start ComfyUI
  llm-switch off           stop model/media services, leave LiteLLM alone
  llm-switch all-off       also stop Asset Forge GPU-profile containers
  llm-switch status        show current state and memory

Boot:
  llm-switch boot-safe
  llm-switch boot-router     safe boot: LiteLLM only; models stay manual
  llm-switch boot-default <slot> [--force-heavy]
  llm-switch boot-status

Slots: ${SLOTS[*]}
EOF
    ;;
  *)
    echo "unknown command: $CMD" >&2
    echo "run 'llm-switch help' for usage" >&2
    exit 1
    ;;
esac
